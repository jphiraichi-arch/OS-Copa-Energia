# Copie para .env (que nunca vai para o git) e ajuste os valores.
# Obrigatória. Exemplo para desenvolvimento com SQLite:
OS_DATABASE_URL=sqlite:///./dev.db
# Obrigatória. Segredo do HMAC das tentativas de login: no mínimo 32 caracteres
# aleatórios, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use um valor diferente em cada ambiente e nunca o coloque no git.
OS_HMAC_SEGREDO=
# Endereços (IPs ou redes, separados por vírgula) do proxy reverso que informa o IP do
# cliente. Só usado no contêiner (docker/iniciar.sh). Padrão: 127.0.0.1.
# OS_PROXIES_CONFIAVEIS=10.0.0.5
# Opcionais (os valores abaixo são os padrões):
OS_TZ=America/Sao_Paulo
OS_SESSAO_TIMEOUT_MIN=30
OS_LOG_LEVEL=INFO
