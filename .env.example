# Copie para .env (que nunca vai para o git) e ajuste os valores.
# Lista completa, com padrões e significado: docs/CONFIGURACAO.md.
# Os valores abaixo são EXEMPLOS seguros; nunca coloque valores reais neste arquivo.

# --- Essenciais ---------------------------------------------------------------
# Obrigatória, sem padrão. Desenvolvimento com SQLite:
OS_DATABASE_URL=sqlite:///./dev.db
# Produção (PostgreSQL), exemplo de formato:
# OS_DATABASE_URL=postgresql://os_app:troque-esta-senha@localhost:5432/sistema_os
# Obrigatória. No mínimo 32 caracteres aleatórios, diferente em cada ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OS_HMAC_SEGREDO=
OS_TZ=America/Sao_Paulo
OS_SESSAO_TIMEOUT_MIN=30
OS_LOG_LEVEL=INFO

# --- Conexão com o banco ------------------------------------------------------
# OS_DB_RECICLAR_CONEXAO_SEGUNDOS=300
# OS_DB_TIMEOUT_CONEXAO_SEGUNDOS=10

# --- Login e IP do cliente ----------------------------------------------------
# OS_LIMITE_FALHAS_IP=100
# OS_ATRASO_MAX_IP_SEGUNDOS=60
# Proxy reverso confiável (IPs ou redes, separados por vírgula). Padrão: 10.0.0.0/8.
# OS_PROXIES_CONFIAVEIS=127.0.0.1
# Cabeçalho com o IP do cliente preenchido pelo proxy (só se ele o sobrescreve):
# OS_CABECALHO_IP_CLIENTE=
# Temporário: 1 grava no log os cabeçalhos de encaminhamento (IPs crus).
# OS_DEPURAR_CABECALHOS_IP=0

# --- Seed (primeira subida) ---------------------------------------------------
# OS_SEED_SENHA=
# OS_SEED_EXEMPLOS=0

# --- E-mail (opcional) e alertas -------------------------------------------------
# Sem estas variáveis os e-mails ficam pendentes na fila. Para testes locais use um
# coletor (veja o README), nunca uma conta real.
# OS_SMTP_HOST=localhost
# OS_SMTP_PORTA=1025
# OS_SMTP_TLS=nenhum
# OS_SMTP_USUARIO=
# OS_SMTP_SENHA=
# OS_SMTP_REMETENTE=sistema-os@exemplo.com.br
# OS_BASE_URL=http://localhost:8550
# OS_EMAIL_MAX_TENTATIVAS=6
# OS_ALERTAS_EMAIL=1

# --- Guia rápido (botão '?') ------------------------------------------------------
# OS_GUIA_ARQUIVO=docs/guia/guia.yaml

# --- Ambiente ------------------------------------------------------------------
# producao | homologacao | desenvolvimento (o preparar-piloto recusa 'producao' sem aviso)
# OS_AMBIENTE=desenvolvimento
